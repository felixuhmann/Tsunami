+    /* Tsunami patch: host-selectable main-bus layouts through clap.audio-ports-config.
+     * Offered only for a processor with exactly one input and one output bus that accepts BOTH
+     * matched mono and matched stereo; every other processor keeps the upstream behaviour of no
+     * configs (extension not exposed). IDs are stable: 1 = mono, 2 = stereo. */
+    struct TsunamiPortsConfig
+    {
+        clap_id id;
+        const char *name;
+        juce::AudioChannelSet layout;
+    };
+    std::vector<TsunamiPortsConfig> tsunamiPortsConfigs;
+
+    void tsunamiDefinePortsConfigs()
+    {
+        tsunamiPortsConfigs.clear();
+        if (processor->getBusCount(true) != 1 || processor->getBusCount(false) != 1)
+            return;
+        const TsunamiPortsConfig candidates[] = {{1, "Mono", juce::AudioChannelSet::mono()},
+                                                 {2, "Stereo", juce::AudioChannelSet::stereo()}};
+        for (const auto &candidate : candidates)
+        {
+            auto layout = processor->getBusesLayout();
+            layout.getChannelSet(true, 0) = candidate.layout;
+            layout.getChannelSet(false, 0) = candidate.layout;
+            if (processor->checkBusesLayoutSupported(layout))
+                tsunamiPortsConfigs.push_back(candidate);
+        }
+        if (tsunamiPortsConfigs.size() < 2)
+            tsunamiPortsConfigs.clear();
+    }
+
+    bool implementsAudioPortsConfig() const noexcept override
+    {
+        return !tsunamiPortsConfigs.empty();
+    }
