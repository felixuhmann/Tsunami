     {
-        DBG("audioPortsConfigCount CALLED - returning 0");
-        return 0;
+        return (uint32_t)tsunamiPortsConfigs.size();
+    }
+    bool audioPortsGetConfig(uint32_t index,
+                             clap_audio_ports_config *config) const noexcept override
+    {
+        if (index >= tsunamiPortsConfigs.size() || config == nullptr)
+            return false;
+        const auto &c = tsunamiPortsConfigs[index];
+        const bool isMono = c.layout == juce::AudioChannelSet::mono();
+        const auto channels = (uint32_t)c.layout.size();
+        config->id = c.id;
+        snprintf(config->name, sizeof(config->name), "%s", c.name);
+        config->input_port_count = 1;
+        config->output_port_count = 1;
+        config->has_main_input = true;
+        config->main_input_channel_count = channels;
+        config->main_input_port_type = isMono ? CLAP_PORT_MONO : CLAP_PORT_STEREO;
+        config->has_main_output = true;
+        config->main_output_channel_count = channels;
+        config->main_output_port_type = isMono ? CLAP_PORT_MONO : CLAP_PORT_STEREO;
+        return true;
     }
